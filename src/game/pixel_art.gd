static func make(role: String, element: String) -> ImageTexture:
	if not MAPS.has(role):
		return null
	var rows: Array = MAPS[role]
	var img := Image.create(rows[0].length(), rows.size(), false, Image.FORMAT_RGBA8)
	var gl: Dictionary = GLAZE.get(element, GLAZE["fire"])
	for y in rows.size():
		var r: String = rows[y]
		for x in r.length():
			var ch := r[x]
			if ch == ".":
				continue
			var c: Color = gl[ch] if gl.has(ch) else COMMON.get(ch, Color.MAGENTA)
			img.set_pixel(x, y, c)
	return ImageTexture.create_from_image(img)
