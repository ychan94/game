+extends SceneTree
+
+func _initialize() -> void:
+	create_timer(35.0).timeout.connect(func(): quit(1))
+	capture.call_deferred()
+
+func capture() -> void:
+	var scene = load("res://src/game/kiln_scene.tscn").instantiate()
+	root.add_child(scene)
+	for i in 8:
+		await physics_frame
+	await RenderingServer.frame_post_draw
+	await RenderingServer.frame_post_draw
+	var target: String = OS.get_cmdline_user_args()[0]
+	var error := root.get_texture().get_image().save_png(target)
+	print("CAPTURE ", target, " RESULT ", error)
+	print("USER_DATA ", OS.get_user_data_dir())
+	quit(0 if error == OK else 1)

