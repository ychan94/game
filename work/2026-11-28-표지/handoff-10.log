func _draw_layer_fit(tx: Texture2D, off: Vector2) -> void:
	var k: float = VIEW.y / tx.get_height()
	var sz: Vector2 = tx.get_size() * k
	draw_texture_rect(tx, Rect2(Vector2((VIEW.x - sz.x) / 2.0, VIEW.y - sz.y) + off, sz), false)


