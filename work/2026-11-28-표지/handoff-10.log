+		scene.queue_redraw()
+		await process_frame
+		await RenderingServer.frame_post_draw
+		await RenderingServer.frame_post_draw
+		var output = ProjectSettings.globalize_path("res://../" + shot[0] + ".png")
+		root.get_texture().get_image().save_png(output)
+		print("saved ", output)
+	quit()

