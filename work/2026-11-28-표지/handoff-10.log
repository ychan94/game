+func _capture() -> void:
+	var scene = load("res://src/game/kiln_scene.tscn").instantiate()
+	root.add_child(scene)
+	await process_frame
+	scene.set_process(false)
+	scene.set_physics_process(false)
+	for shot in [["title-center", 0.0], ["title-sway-right", 392.699], ["title-sway-left", 1178.097]]:
