"""Godot 실행 파일 찾기 + 화면 없이 스크립트 돌리기 (test.py, perf/bench.py 가 함께 쓴다).

찾는 순서: 환경 변수 GODOT → PATH 의 godot / godot4 → Windows 기본 위치의 *console*.exe
"""
import glob
import json
import os
import pathlib
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[1]


def find_godot():
    env = os.environ.get("GODOT")
    if env and pathlib.Path(env).exists():
        return env
    for name in ("godot", "godot4", "Godot"):
        p = shutil.which(name)
        if p:
            return p
    if sys.platform == "win32":
        home = pathlib.Path.home()
        pats = [str(home / "**" / "Godot_v4*_console.exe"), "C:/Godot/**/Godot_v4*_console.exe",
                "C:/Program Files/Godot/**/Godot_v4*_console.exe"]
        for pat in pats:
            hits = sorted(glob.glob(pat, recursive=True))
            if hits:
                return hits[-1]
    return None


def run_script(script, args=(), capture=True):
    """res://... 스크립트를 화면 없이 돌린다. (종료 코드, 출력 줄들, RESULT_JSON 목록)"""
    godot = find_godot()
    if not godot:
        print("Godot 를 찾지 못했습니다. 환경 변수 GODOT 에 Godot 실행 파일(Windows는 *_console.exe) 경로를 넣어 주세요.")
        return 3, [], []
    env = {**os.environ, "PYTHONUTF8": "1"}
    if not (ROOT / ".godot").exists():
        subprocess.run([godot, "--headless", "--path", str(ROOT), "--import"], cwd=ROOT,
                       capture_output=True, env=env, timeout=600)
    r = subprocess.run([godot, "--headless", "--path", str(ROOT), "--script", script, "--", *args], cwd=ROOT,
                       capture_output=True, text=True, encoding="utf-8", errors="replace", env=env, timeout=1800)
    lines = (r.stdout + r.stderr).splitlines()
    results, shown = [], []
    for line in lines:
        if line.startswith("RESULT_JSON:"):
            results.append(json.loads(line[len("RESULT_JSON:"):]))
        elif not line.startswith("Godot Engine") and line.strip():
            shown.append(line)
    return r.returncode, shown, results

extends SceneTree
## 1분 시험판 장면별 스크린샷 (화면 확인용).
##   godot --path . --rendering-driver opengl3 --script res://tests/screens_proto.gd -- <저장 폴더>

var out_dir := ""


func _initialize() -> void:
	var args := OS.get_cmdline_user_args()
	out_dir = args[0] if args.size() > 0 else OS.get_user_data_dir()
	DirAccess.make_dir_recursive_absolute(out_dir)
	create_timer(240.0).timeout.connect(func(): print("시간 초과"); quit(1))
	_all.call_deferred()


func _frames(n: int) -> void:
	for i in n:
		await physics_frame  # 게임 시간 기준 (그리기는 더 빠를 수 있다)


func _snap(name: String) -> void:
	await _frames(2)
	await RenderingServer.frame_post_draw  # 화면이 실제로 다 그려진 뒤에 찍는다
	await RenderingServer.frame_post_draw
	root.get_viewport().get_texture().get_image().save_png(out_dir.path_join(name + ".png"))
	print("saved ", name)


func _open(path: String) -> Node:
	for c in root.get_children():
		c.queue_free()
	await _frames(1)
	var n: Node = load(path).instantiate()
	root.add_child(n)
	await _frames(2)
	return n


func _all() -> void:

	# ---- B 가마의 병사 (밤 5번) ----
	var k = await _open("res://src/game/kiln_scene.tscn")
	if k.get_script() == null:
		print("kiln 불러오기 실패"); quit(1); return
	await _snap("p00b_kiln_title")
	k.meta.embers = 64
	k.meta.levels = {"core": 1, "wall": 2, "clay": 1, "ticket": 1, "train": 1, "purse": 1, "fire": 1}
	k.state = "meta"
	k.meta_hover = ""
	await _snap("p00c_kiln_meta")
	k.meta.records = {"1": [{"time": 132.4, "date": "2026-11-29", "army": ""}, {"time": 151.0, "date": "2026-11-28", "army": ""}], "2": [{"time": 201.7, "date": "2026-11-29", "army": ""}]}
	k.state = "records"
	await _snap("p00d_kiln_records")
	k.state = "prep"
	var run = k.run
	k.tut_seen = {}
	await _snap("p01a_kiln_tutorial_draw")
	# 7종이 다 보이게 정해서 뽑는다 (실제 게임은 무작위)
	for f in [["shield", "earth"], ["spear", "fire"], ["axe", "fire"], ["cavalry", "fire"], ["archer", "water"], ["healer", "water"], ["cannon", "earth"], ["spear", "fire"]]:
		run.draw(f[0], f[1])
	run.since["rare"] = 5
	await _snap("p01_kiln_prep_first")
	k.state = "gacha"
	await _snap("p01b_kiln_gacha")
	k.state = "load"
	k.load_t = 0
	await _frames(28)
	await _snap("p01c_kiln_load")
	k.state = "fire"
	for i in 6:
		k.kiln.heat_up()
	await _frames(70)
	await _snap("p02_kiln_fire")
	for i in 3:
		k.kiln.heat_up()
	await _frames(70)
	k.bet_on = true
	await _snap("p02b_kiln_fire_hot")
	run.kiln.heat = 4
	run.bet_busts = 3   # 대박이 나오는 장면
	k.kiln.results = run.fire(true)
	k.bet_on = false
	k.bet_told = false
	k.kiln.results[1]["tier"] = "legend"
	run.army[1]["tier"] = "legend"
	k.kiln.results[3]["cracked"] = true
	k.state = "reveal"
	k.reveal_t = 0
	k.reveal_shown = 0
	await _frames(40)
	await _snap("p02c_kiln_open")
	await _frames(75)
	await _snap("p03_kiln_reveal_legend")
	k.reveal_t = 400
	await _frames(4)
	if not k.gfx.is_empty():
		k.gfx["taps"] = 1
		k.gfx["need"] = 3
		await _frames(2)
		await _snap("p03a_kiln_gacha_tap")
